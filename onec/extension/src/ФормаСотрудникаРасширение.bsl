// ============================================================================
// Фрагмент кода для расширения формы справочника "Сотрудники" (УНФ).
// Вариант А: фото НЕ хранится в 1С вообще — выбирается с диска пользователя
// в момент нажатия кнопки, результат показывается на форме и по желанию
// сохраняется как файл на диск. Внутри 1С не сохраняется ничего, структура
// справочника Сотрудники не меняется — используется только системный
// идентификатор ссылки (employee_ref), который есть у любого элемента
// любого справочника "из коробки".
//
// В Конфигураторе: расширение → Формы → добавить расширяемую форму
// "Сотрудники.ФормаЭлемента", затем:
//   1) команды: "ВыбратьФотоСДиска", "СоздатьАватар", "СохранитьАватарКакФайл"
//      (три кнопки на командной панели формы);
//   2) новый РЕКВИЗИТ ФОРМЫ (не справочника!) "АдресРезультатаАватара"
//      (тип Строка) — хранит адрес во временном хранилище с готовой картинкой;
//   3) элемент формы "Поле картинки", путь к данным = АдресРезультатаАватара
//      (чтобы результат сразу был виден на форме).
// Код ниже вставляется в модуль этой расширяемой формы.
// ============================================================================

&НаКлиенте
Перем ИДЗаданияГенерацииАватара;

&НаКлиенте
Перем АдресВыбранногоФото;

// ------------------------------------------------------------------
// Кнопка 1 — выбрать фото с диска. Файл читается платформой во временное
// хранилище (живёт, пока открыта форма) и НИКУДА в 1С не записывается.
// ------------------------------------------------------------------
&НаКлиенте
Процедура ВыбратьФотоСДиска(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФотоЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФотоЗавершение(Результат, АдресВХранилище, ИмяФайла, ДопПараметры) Экспорт

	Если Результат Тогда
		АдресВыбранногоФото = АдресВХранилище;
		Сообщить("Фото выбрано: " + ИмяФайла + ". Теперь нажмите ""Создать аватар"".");
	Иначе
		Сообщить("Фото не выбрано.");
	КонецЕсли;

КонецПроцедуры

// ------------------------------------------------------------------
// Кнопка 2 — запустить генерацию по уже выбранному фото.
// СотрудникСсылка передаётся только чтобы сервис записал employee_ref
// (для истории/фильтрации в PostgreSQL) — 1С при этом ничего не сохраняет.
// ------------------------------------------------------------------
&НаКлиенте
Процедура СоздатьАватар(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Сначала сохраните карточку сотрудника.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(АдресВыбранногоФото) Тогда
		ПоказатьПредупреждение(, "Сначала выберите фото кнопкой ""Выбрать фото с диска"".");
		Возврат;
	КонецЕсли;

	// Стиль можно захардкодить, взять из поля выбора на форме или из констант — на ваш выбор.
	Запуск = НачатьГенерациюАватараНаСервере(АдресВыбранногоФото, Объект.Ссылка, "corporate");

	Если НЕ Запуск.Успех Тогда
		ПоказатьПредупреждение(, "Не удалось запустить генерацию: " + Запуск.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ИДЗаданияГенерацииАватара = Запуск.IDЗадания;
	АдресРезультатаАватара = ""; // очищаем превью предыдущего запуска

	Сообщить("Аватар генерируется, обычно это занимает от нескольких секунд до минуты...");
	ПодключитьОбработчикОжидания("ПроверитьГотовностьАватараОжидание", 3, Истина);

КонецПроцедуры

// Обработчик таймера: вызывается платформой каждые 3 секунды, пока сам себя не отключит.
&НаКлиенте
Процедура ПроверитьГотовностьАватараОжидание()

	Статус = ПроверитьСтатусАватараНаСервере(ИДЗаданияГенерацииАватара);

	Если НЕ Статус.Успех Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьАватараОжидание");
		ПоказатьПредупреждение(, "Ошибка обращения к сервису: " + Статус.СообщениеОбОшибке);
		Возврат;
	КонецЕсли;

	Если НЕ Статус.Готово Тогда
		Возврат; // ещё не готово — платформа вызовет эту процедуру снова через 3 секунды
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьГотовностьАватараОжидание");

	Если Статус.Статус = "done" Тогда
		Результат = ЗабратьРезультатНаСервере(ИДЗаданияГенерацииАватара);
		Если Результат.Успех Тогда
			АдресРезультатаАватара = Результат.Адрес;
			Сообщить("Готово! Аватар показан на форме. При необходимости сохраните его кнопкой "
				+ """Сохранить как файл"".");
		Иначе
			ПоказатьПредупреждение(, "Не удалось получить готовый аватар: " + Результат.ТекстОшибки);
		КонецЕсли;
	Иначе
		// status = "rejected" (не подходит исходное фото) или "failed" (не пройдена проверка лица)
		ПоказатьПредупреждение(, "Не удалось создать аватар: " + Статус.СообщениеОбОшибке);
	КонецЕсли;

КонецПроцедуры

// ------------------------------------------------------------------
// Кнопка 3 — сохранить готовый аватар как файл на диск пользователя (опционально).
// ------------------------------------------------------------------
&НаКлиенте
Процедура СохранитьАватарКакФайл(Команда)

	Если ПустаяСтрока(АдресРезультатаАватара) Тогда
		ПоказатьПредупреждение(, "Сначала создайте аватар.");
		Возврат;
	КонецЕсли;

	ИмяФайла = "avatar_" + Объект.Ссылка.УникальныйИдентификатор() + ".png";

	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(Новый ОписаниеПереносимогоФайла(АдресРезультатаАватара, ИмяФайла));
	НачатьПолучениеФайлов(Неопределено, МассивФайлов, Истина);

КонецПроцедуры

// ------------------------------------------------------------------
// Серверные обёртки — каждая делает ОДИН короткий вызов и сразу
// возвращает управление клиенту (никакого ожидания на сервере).
// ------------------------------------------------------------------

&НаСервере
Функция НачатьГенерациюАватараНаСервере(АдресФото, СотрудникСсылка, Стиль)

	ДвоичныеДанныеФото = ПолучитьИзВременногоХранилища(АдресФото);
	Возврат ИнтеграцияГенерацияАватаров.ОтправитьФотоНаГенерацию(ДвоичныеДанныеФото, Стиль, СотрудникСсылка);

КонецФункции

&НаСервере
Функция ПроверитьСтатусАватараНаСервере(ИДЗадания)
	Возврат ИнтеграцияГенерацияАватаров.ПолучитьСтатусЗадания(ИДЗадания);
КонецФункции

&НаСервере
Функция ЗабратьРезультатНаСервере(ИДЗадания)

	Изображение = ИнтеграцияГенерацияАватаров.ПолучитьИзображениеАватара(ИДЗадания);
	Если НЕ Изображение.Успех Тогда
		Возврат Новый Структура("Успех, ТекстОшибки, Адрес", Ложь, Изображение.ТекстОшибки, "");
	КонецЕсли;

	Адрес = ПоместитьВоВременноеХранилище(Изображение.ДвоичныеДанные, УникальныйИдентификатор);
	Возврат Новый Структура("Успех, ТекстОшибки, Адрес", Истина, "", Адрес);

КонецФункции
