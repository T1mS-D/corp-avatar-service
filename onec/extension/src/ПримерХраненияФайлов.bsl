// Пример реализации двух вспомогательных функций для конкретной базы 1С:УНФ.
// Вставляются в тот же общий модуль ИнтеграцияГенерацияАватаров (область ПрограммныйИнтерфейс).
// Приведён вариант через стандартную подсистему "ПрисоединенныеФайлы" (БСП),
// которая используется в типовой УНФ. При иной организации хранения фото —
// поправьте запрос/запись под свою структуру данных.

// Возвращает двоичные данные последнего присоединённого файла-изображения сотрудника, либо Неопределено.
Функция ПолучитьФотоСотрудника(СотрудникСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФайлыСотрудников.Ссылка КАК ФайлСсылка
	|ИЗ
	|	Справочник.ПрисоединенныеФайлы КАК ФайлыСотрудников
	|ГДЕ
	|	ФайлыСотрудников.ВладелецФайла = &Сотрудник
	|	И НЕ ФайлыСотрудников.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ФайлыСотрудников.Дата УБЫВ";
	Запрос.УстановитьПараметр("Сотрудник", СотрудникСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РаботаСФайлами.ПолучитьДвоичныеДанныеФайла(Выборка.ФайлСсылка);

КонецФункции

// Сохраняет сгенерированный аватар как новый присоединённый файл сотрудника ("Аватар_<дата>.png").
Процедура ЗаписатьАватарСотрудника(СотрудникСсылка, ДвоичныеДанныеАватара) Экспорт

	ИмяФайла = "Аватар_" + Формат(ТекущаяДата(), "ДФ=ГГГГММДДчч_мм_сс") + ".png";
	РаботаСФайлами.СоздатьФайлПоДвоичнымДанным(СотрудникСсылка, ИмяФайла, ДвоичныеДанныеАватара);

КонецПроцедуры
