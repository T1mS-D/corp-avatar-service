// ============================================================================
// Общий модуль расширения: ИнтеграцияГенерацияАватаров
// Свойства модуля в Конфигураторе: Клиент (управляемое приложение) = Ложь,
//                                   Сервер = Истина, Внешнее соединение = Истина,
//                                   Повторное использование возвращаемых значений = Не использовать.
//
// Модуль вызывает внешний HTTP-сервис "Corporate Avatar Service" (см. корень репозитория)
// из 1С:УНФ и сохраняет готовый аватар как файл сотрудника.
// ============================================================================

#Область ПрограммныйИнтерфейс

// Отправляет фото сотрудника на генерацию аватара и возвращает Job ID.
//
// Параметры:
//  ДвоичныеДанныеФото - ДвоичныеДанные - фото сотрудника (JPEG/PNG)
//  Стиль              - Строка        - "corporate" | "brand" | "cartoon"
//  СотрудникСсылка    - СправочникСсылка.Сотрудники - для передачи employee_ref
//
// Возвращаемое значение:
//  Структура со свойствами: Успех (Булево), IDЗадания (Строка), ТекстОшибки (Строка)
Функция ОтправитьФотоНаГенерацию(ДвоичныеДанныеФото, Стиль = "corporate", СотрудникСсылка = Неопределено) Экспорт

	Результат = Новый Структура("Успех, IDЗадания, ТекстОшибки", Ложь, "", "");

	Настройки = ПолучитьНастройкиСервиса();
	Если НЕ Настройки.Успех Тогда
		Результат.ТекстОшибки = Настройки.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("image_base64", ПредставлениеВБазе64(ДвоичныеДанныеФото));
	Тело.Вставить("style", Стиль);
	Если СотрудникСсылка <> Неопределено Тогда
		Тело.Вставить("employee_ref", Строка(СотрудникСсылка.УникальныйИдентификатор()));
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Настройки, "POST", "/api/v1/avatars", Тело);
	Если НЕ Ответ.Успех Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Данные = РазобратьJSON(Ответ.Тело);
	Идентификатор = "";
	Данные.Свойство("id", Идентификатор);

	Результат.Успех = Истина;
	Результат.IDЗадания = Идентификатор;
	Возврат Результат;

КонецФункции

// Опрашивает статус задания. Статусы сервиса: queued, processing, done, rejected, failed.
//
// Возвращаемое значение:
//  Структура: Успех, Статус, Готово (Булево), СообщениеОбОшибке, Метрики (Соответствие)
Функция ПолучитьСтатусЗадания(IDЗадания) Экспорт

	Результат = Новый Структура("Успех, Статус, Готово, СообщениеОбОшибке, Метрики",
		Ложь, "", Ложь, "", Неопределено);

	Настройки = ПолучитьНастройкиСервиса();
	Если НЕ Настройки.Успех Тогда
		Результат.СообщениеОбОшибке = Настройки.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Настройки, "GET", "/api/v1/avatars/" + IDЗадания, Неопределено);
	Если НЕ Ответ.Успех Тогда
		Результат.СообщениеОбОшибке = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Данные = РазобратьJSON(Ответ.Тело);

	Статус = "";
	Данные.Свойство("status", Статус);

	ТекстОшибкиИзОтвета = Неопределено;
	Данные.Свойство("error", ТекстОшибкиИзОтвета);

	Метрики = Неопределено;
	Данные.Свойство("metrics", Метрики);

	Результат.Успех = Истина;
	Результат.Статус = Статус;
	Результат.Готово = (Статус = "done") ИЛИ (Статус = "failed") ИЛИ (Статус = "rejected");
	Если ТекстОшибкиИзОтвета <> Неопределено Тогда
		Результат.СообщениеОбОшибке = ТекстОшибкиИзОтвета;
	КонецЕсли;
	Результат.Метрики = Метрики;

	Возврат Результат;

КонецФункции

// Скачивает готовое изображение аватара (только для статуса "done").
//
// Возвращаемое значение:
//  Структура: Успех, ДвоичныеДанные, ТекстОшибки
Функция ПолучитьИзображениеАватара(IDЗадания) Экспорт

	Результат = Новый Структура("Успех, ДвоичныеДанные, ТекстОшибки", Ложь, Неопределено, "");
	Настройки = ПолучитьНастройкиСервиса();
	Если НЕ Настройки.Успех Тогда
		Результат.ТекстОшибки = Настройки.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Настройки, "GET", "/api/v1/avatars/" + IDЗадания + "/image", Неопределено, Истина);
	Если НЕ Ответ.Успех Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.ДвоичныеДанные = Ответ.ДвоичныеДанные;
	Возврат Результат;

КонецФункции

// Синхронный сценарий «отправить и дождаться» — БЛОКИРУЮЩИЙ, доступен ТОЛЬКО в контексте
// "Внешнее соединение" (COM/OLE-автоматизация из внешнего скрипта на Python/.NET/PowerShell
// и т.п.), потому что использует ПриостановитьРаботу, а она недоступна на сервере 1С
// (блокирующий sleep занял бы рабочий процесс rphost, который обслуживает других
// пользователей, — платформа такое запрещает).
//
// Для интерактивной кнопки в форме 1С (клиентское приложение) НЕ вызывайте эту функцию
// с сервера — используйте неблокирующий опрос с клиента через ПодключитьОбработчикОжидания,
// см. пример в onec/extension/src/ФормаСотрудникаРасширение.bsl (три коротких серверных
// вызова ОтправитьФотоНаГенерацию / ПолучитьСтатусЗадания / ПолучитьИзображениеАватара,
// таймер опроса — на клиенте).
//
// Возвращаемое значение:
//  Структура: Успех, ДвоичныеДанныеАватара, СообщениеОбОшибке
Функция СгенерироватьАватарИДождаться(ДвоичныеДанныеФото, Стиль = "corporate",
	СотрудникСсылка = Неопределено, ТаймаутСек = 120, ИнтервалОпросаСек = 3) Экспорт

	Результат = Новый Структура("Успех, ДвоичныеДанныеАватара, СообщениеОбОшибке", Ложь, Неопределено, "");

	Отправка = ОтправитьФотоНаГенерацию(ДвоичныеДанныеФото, Стиль, СотрудникСсылка);
	Если НЕ Отправка.Успех Тогда
		Результат.СообщениеОбОшибке = Отправка.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	ВремяНачала = ТекущаяДата();
	Пока ТекущаяДата() - ВремяНачала < ТаймаутСек Цикл

		Статус = ПолучитьСтатусЗадания(Отправка.IDЗадания);
		Если НЕ Статус.Успех Тогда
			Результат.СообщениеОбОшибке = Статус.СообщениеОбОшибке;
			Возврат Результат;
		КонецЕсли;

		Если Статус.Готово Тогда
			Если Статус.Статус = "done" Тогда
				Изображение = ПолучитьИзображениеАватара(Отправка.IDЗадания);
				Результат.Успех = Изображение.Успех;
				Результат.ДвоичныеДанныеАватара = Изображение.ДвоичныеДанные;
				Результат.СообщениеОбОшибке = Изображение.ТекстОшибки;
			Иначе
				// rejected  — не подходит исходное фото; failed — не пройдена проверка сохранности лица
				Результат.СообщениеОбОшибке = Статус.СообщениеОбОшибке;
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;

		#Если ВнешнееСоединение Тогда
			ПриостановитьРаботу(ИнтервалОпросаСек);
		#Иначе
			ВызватьИсключение "СгенерироватьАватарИДождаться доступна только в контексте ""Внешнее"
				+ " соединение"" (блокирующий sleep запрещён на сервере 1С). Для формы 1С используйте"
				+ " неблокирующий клиентский опрос — см. ФормаСотрудникаРасширение.bsl.";
		#КонецЕсли

	КонецЦикла;

	Результат.СообщениеОбОшибке = "Превышено время ожидания генерации аватара (" + ТаймаутСек + " сек)";
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройки хранятся в константах расширения (см. РАЗДЕЛ "Константы" в README):
//   КонстантаАватарыURLСервиса, КонстантаАватарыAPIKey
Функция ПолучитьНастройкиСервиса()

	Результат = Новый Структура("Успех, БазовыйURL, APIKey, ТекстОшибки", Ложь, "", "", "");

	БазовыйURL = ПолучитьКонстанту("АватарыURLСервиса"); // например, https://avatars.mycompany.local
	APIKey = ПолучитьКонстанту("АватарыAPIKey");

	Если ПустаяСтрока(БазовыйURL) Тогда
		Результат.ТекстОшибки = "Не задана константа ""АватарыURLСервиса"". "
			+ "Укажите адрес сервиса генерации аватаров в настройках интеграции.";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.БазовыйURL = СокрЛП(БазовыйURL);
	Пока Прав(Результат.БазовыйURL, 1) = "/" Цикл
		Результат.БазовыйURL = Лев(Результат.БазовыйURL, СтрДлина(Результат.БазовыйURL) - 1);
	КонецЦикла;
	Результат.APIKey = APIKey;
	Возврат Результат;

КонецФункции

// Обёртка получения константы по имени (чтобы не завязываться на конкретный менеджер констант,
// если проект решит хранить настройки в регистре сведений — правится только тут).
Функция ПолучитьКонстанту(Имя)
	Попытка
		Возврат Константы[Имя].Получить();
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Универсальный HTTP-вызов сервиса через HTTPСоединение/HTTPЗапрос платформы 1С.
//
// Параметры:
//  Настройки        - Структура, см. ПолучитьНастройкиСервиса()
//  Метод            - Строка "GET" | "POST" | "DELETE"
//  Путь             - Строка, например "/api/v1/avatars"
//  Тело             - Структура (будет сериализована в JSON) или Неопределено
//  ЭтоФайл          - Булево, Истина для скачивания бинарного ответа (изображения)
//
// Возвращаемое значение:
//  Структура: Успех, КодСостояния, Тело (Строка, для JSON-ответов),
//             ДвоичныеДанные (для файлов), ТекстОшибки
Функция ВыполнитьЗапрос(Настройки, Метод, Путь, Тело, ЭтоФайл = Ложь)

	Результат = Новый Структура("Успех, КодСостояния, Тело, ДвоичныеДанные, ТекстОшибки",
		Ложь, 0, "", Неопределено, "");

	СтрокаСоединения = Настройки.БазовыйURL;
	ИспользоватьЗащищенноеСоединение = (Лев(СтрокаСоединения, 8) = "https://");
	Хост = "";
	Порт = Неопределено;

	Если ИспользоватьЗащищенноеСоединение Тогда
		БезСхемы = Сред(СтрокаСоединения, 9);
	Иначе
		БезСхемы = Сред(СтрокаСоединения, 8);
	КонецЕсли;

	ПозицияСлеша = Найти(БезСхемы, "/");
	Если ПозицияСлеша > 0 Тогда
		ХостПорт = Лев(БезСхемы, ПозицияСлеша - 1);
	Иначе
		ХостПорт = БезСхемы;
	КонецЕсли;

	ПозицияДвоеточия = Найти(ХостПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Хост = Лев(ХостПорт, ПозицияДвоеточия - 1);
		Порт = Число(Сред(ХостПорт, ПозицияДвоеточия + 1));
	Иначе
		Хост = ХостПорт;
	КонецЕсли;

	Прокси = Неопределено;
	ЗащищенноеСоединение = Неопределено;
	Если ИспользоватьЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение(Хост, Порт, , , Прокси, , ЗащищенноеСоединение);
	Исключение
		Результат.ТекстОшибки = "Не удалось подключиться к сервису (" + Хост + "): "
			+ ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-API-Key", Настройки.APIKey);
	Заголовки.Вставить("Accept", "application/json");

	ТелоЗапроса = "";
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json");
		ТелоЗапроса = СтруктураВJSON(Тело);
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если НЕ ПустаяСтрока(ТелоЗапроса) Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		Результат.ТекстОшибки = "Ошибка HTTP-запроса к " + Путь + ": " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = Ответ.КодСостояния;

	Если Ответ.КодСостояния >= 400 Тогда
		Результат.ТекстОшибки = "Сервис вернул ошибку " + Ответ.КодСостояния + ": "
			+ Ответ.ПолучитьТелоКакСтроку();
		Возврат Результат;
	КонецЕсли;

	Если ЭтоФайл Тогда
		Результат.ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Иначе
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Кодирует двоичные данные в base64 (Base64Строка — встроенная функция платформы).
Функция ПредставлениеВБазе64(ДвоичныеДанные)
	Возврат Base64Строка(ДвоичныеДанные);
КонецФункции

// Сериализация Структуры в JSON без внешних библиотек (штатный ЗаписьJSON платформы).
Функция СтруктураВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

// Разбор JSON-ответа сервиса в структуру/соответствие (штатный ЧтениеJSON платформы).
Функция РазобратьJSON(Знач ТекстJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Возврат ПрочитатьJSON(Чтение, Истина); // Истина = свойства как СтруктураСОстоянием (Свойство/точечная нотация)
КонецФункции

#КонецОбласти
