// ============================================================================
// Автономный тест связи 1С ↔ сервис. НЕ зависит от расширения — можно проверить
// сеть до того, как разбираться с логикой хранения фото сотрудников.
//
// Как запустить (любой вариант):
//  а) Через любую "консоль кода"/"консоль запросов" (внешняя обработка для 1С,
//     позволяющая выполнить произвольный BSL-код) — выберите контекст выполнения
//     "На сервере" (HTTPСоединение недоступно в контексте тонкого/веб-клиента).
//  б) Временно вставьте тело этого кода в обработчик какой-нибудь тестовой кнопки
//     формы, помеченный &НаСервере.
//  в) В самом Конфигураторе: Сервис → Программы обработки → или через отладчик,
//     если у вас включён режим отладки — поставьте точку останова и выполните
//     построчно (Shift+F9 "Вычислить выражение").
//
// Ожидаемый результат в окне сообщений:
//   Код ответа: 200
//   {"status":"ok","backend":"classic"}
//
// Если ошибка "Не удалось подключиться" — проверьте:
//   - запущен ли сервис: в WSL/терминале docker compose ps должен показывать api как healthy;
//   - тот же порт: curl http://localhost:8000/health из WSL тоже должен отвечать;
//   - если 1С стоит НЕ на той же машине, что Docker Desktop — замените "localhost"
//     на реальный IP машины с Docker (ipconfig → IPv4-адрес).
// ============================================================================

Сервер = "localhost";
Порт = 8000;

Попытка
	Соединение = Новый HTTPСоединение(Сервер, Порт);
	Запрос = Новый HTTPЗапрос("/health");
	Ответ = Соединение.ВызватьHTTPМетод("GET", Запрос);
	Сообщить("Код ответа: " + Ответ.КодСостояния);
	Сообщить(Ответ.ПолучитьТелоКакСтроку());
Исключение
	Сообщить("Ошибка подключения: " + ОписаниеОшибки());
КонецПопытки;

