# ===== PostgreSQL =====
POSTGRES_USER=avatar
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=avatar_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== API =====
# Ключ, который 1С передаёт в заголовке X-API-Key. Сгенерировать: openssl rand -hex 32
API_KEY=change_me_long_random_key
API_PORT=8000
MAX_UPLOAD_MB=10

# ===== Пайплайн =====
# classic   - CPU, без генеративных моделей: кадрирование + замена фона (быстрый демо-режим)
# diffusion - GPU: замена одежды (Stable Diffusion inpainting) + IP-Adapter FaceID + мульт-стиль
PIPELINE_BACKEND=classic
WORKER_POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=600
MAX_ATTEMPTS=3
OUTPUT_SIZE=768

# ===== Фирменный стиль =====
BRAND_PRIMARY_COLOR=#0B5FA5
BRAND_SECONDARY_COLOR=#E8F1FA
BRAND_NAME=Acme

# ===== Проверки качества / сохранности лица =====
# косинусное сходство ArcFace: оригинал vs результат
FACE_SIM_THRESHOLD=0.55
FACE_SIM_THRESHOLD_CARTOON=0.30
MIN_FACE_PX=110
MAX_YAW_DEG=40
MIN_SHARPNESS=40

# ===== Diffusion (нужно только при PIPELINE_BACKEND=diffusion) =====
HF_TOKEN=
HF_HOME=/models/hf
SD_INPAINT_MODEL=stable-diffusion-v1-5/stable-diffusion-inpainting
SD_IMG2IMG_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
IP_ADAPTER_REPO=h94/IP-Adapter-FaceID
IP_ADAPTER_WEIGHT=ip-adapter-faceid_sd15.bin
IP_ADAPTER_SCALE=0.7
CARTOON_LORA_PATH=
DIFFUSION_SIZE=512
DIFFUSION_STEPS=30
CPU_OFFLOAD=true
INSIGHTFACE_HOME=/models/insightface
U2NET_HOME=/models/u2net
